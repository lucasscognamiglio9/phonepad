{
  "expo": {
    "name": "Phonepad",
    "slug": "phonepad",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/phonepad-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.phonepad.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false,
      "buildNumber": "6"
    },
    "android": {
      "package": "app.phonepad.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/phonepad-icon.png",
        "backgroundColor": "#090b0e"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/receive-only.cjs",
      "./plugins/video-renderer.cjs",
      "expo-router",
      "@config-plugins/react-native-webrtc",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usar la cámara del iPhone como webcam de tu computadora y tomar fotos para enviarle.",
          "photosPermission": "Elegir fotos para enviarlas a tu computadora.",
          "microphonePermission": "Usar el micrófono del iPhone como micrófono de tu computadora."
        }
      ],
      "expo-document-picker",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 20,
            "NSExtensionActivationSupportsMovieWithMaxCount": 20,
            "NSExtensionActivationSupportsFileWithMaxCount": 20
          },
          "iosShareExtensionName": "Enviar a Phonepad",
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*",
            "application/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*",
            "application/*"
          ]
        }
      ]
    ],
    "scheme": "phonepad",
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false
    }
  }
}
